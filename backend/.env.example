# Port the backend listens on
PORT=3001

# Comma-separated list of origins allowed to call the API.
# In production this should be your real frontend origin(s), e.g.:
# ALLOWED_ORIGINS=https://downloader.example.com
ALLOWED_ORIGINS=http://localhost:3001

# Where downloaded files are written before being streamed to the client
# and where "open folder" points to. Defaults to ~/Downloads/yeti if unset.
# DOWNLOADS_DIR=/home/user/Downloads/yeti

# Path to the yt-dlp binary. Defaults to "yt-dlp" (must be on PATH).
# YTDLP_PATH=yt-dlp

# Max concurrent yt-dlp info/download processes the server will run at once.
MAX_CONCURRENT_JOBS=3

# Rate limits (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=60
RATE_LIMIT_MAX_DOWNLOAD=30

# Log level: error | warn | info | debug
LOG_LEVEL=info
